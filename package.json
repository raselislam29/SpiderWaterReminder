{
  "name": "spider-water-reminder",
  "productName": "SpiderWaterReminder",
  "version": "1.0.0",
  "description": "SpiderWaterReminder — satisfying water reminders with every drop",
  "main": "electron/main.js",
  "author": "Rasel Islam",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.spiderwaterreminder.app",
    "productName": "SpiderWaterReminder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "SpiderWaterReminder-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpiderWaterReminder"
    },
    "portable": {
      "artifactName": "SpiderWaterReminder-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "SpiderWaterReminder-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "SpiderWaterReminder ${version}"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
